{
  "manifest_version": 3,
  "name": "YT Quick Controls",
  "version": "1.2",
  "description": "Scroll to control YouTube speed (0.25x-16x) on a player button, volume by holding right-click and scrolling, and a one-click quality button.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["main.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
